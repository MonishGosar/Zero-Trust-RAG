# Azure OpenAI resource URL. Keep real credentials in .env only.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional separate embedding resource.
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
# Empty uses the v1 API; set for the older Azure deployment API.
AZURE_OPENAI_API_VERSION=
# Empty uses persistent local Qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_v1
DATA_DIR=.data
MAX_UPLOAD_MB=20
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
# Auto uses native text only for simple PDFs; docling forces structure reconstruction.
PDF_PARSING_MODE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_MAX_TOKENS=24000
# Optional stable JWT signing secret (at least 32 characters). Empty generates an
# in-memory key on startup; restarting then requires users to sign in again.
AUTH_JWT_SECRET=
# Set true with HTTPS. Keep false for local HTTP development.
AUTH_COOKIE_SECURE=false
# JSON array. Defaults include loopback UI ports 3000, 3001 and test port 3100.
# AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:3001"]
